# secrets
.env
CLAUDE.md

# Local workspace: keeps host builds on ../mneme (live local edits) while the
# committed go.mod pins the published mneme commit — which is what lets a JARVIS
# worker export (no go.work, no ../mneme) still `go build ./...` from the module
# cache. Bump the pin when driver-os starts depending on newer mneme commits.
/go.work
/go.work.sum

# Go
/bin/
*.out
*.test
__debug_bin*
# stray root-level `go build` output (binary named after its cmd dir).
# Anchored with a leading slash — a bare pattern like `driver` would also
# ignore the cmd/driver/ SOURCE directory and hide new files from git status.
/counciltest
/commit-msg
/driver
/gameserver
/jarvis-probe
/synthbank
# council scratch artifacts (real runs persist under $XDG_DATA_HOME/driver-os/council/)
/_council_*

# agent long-term memory (mneme sqlite store)
*.db
*.db-*

# local tool caches / browser-session artifacts
/.ruff_cache/
/.playwright-mcp/

# session scratch (chat-delivered artifacts, temp working files)
/scratchpad/

# Cloned dependency source for browsing (see _deps/README.md).
# Leading underscore so the go tool ignores it (keeps `go build ./...` clean).
/_deps/*
_deps/
!/_deps/README.md
!/_deps/repos.txt

# Eval harness generated reports (HP-11)
eval/runs/

# Duet Lab frontend: node deps + Vite build output. The build output is embedded
# at compile time (experiments/lab/embed.go), but it's a generated artifact — keep only the
# committed placeholder so `go build ./...` works before `make lab-build`.
experiments/lab/web/node_modules/
experiments/lab/web/dist/*
!experiments/lab/web/dist/.gitkeep

# Vault PWA: same deal — embedded at compile time (experiments/vault/embed.go), generated
# artifact, keep only the committed placeholder.
experiments/vault/web/node_modules/
experiments/vault/web/dist/*
!experiments/vault/web/dist/.gitkeep
